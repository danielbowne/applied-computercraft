#!/bin/sh
# Refuses to commit on main. Allowed while a merge, cherry-pick or revert is in progress, and
# when $CI is set. Enable with:
#   git config core.hooksPath .githooks

[ -n "${CI:-}" ] && exit 0

for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    path=$(git rev-parse --git-path "$marker" 2>/dev/null)
    [ -n "$path" ] && [ -e "$path" ] && exit 0
done

branch=$(git branch --show-current 2>/dev/null)
if [ "$branch" = "main" ]; then
    echo "pre-commit: refusing to commit on main. Create a branch first: git switch -c <type>/<slug>" >&2
    exit 1
fi
exit 0
